generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  email        String    @unique
  passwordHash String
  profileImage String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  followers    Follow[]  @relation("FollowFollowing")
  following    Follow[]  @relation("FollowFollower")
  pins         Pin[]
  boards       Board[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Pin {
  id             String   @id @default(cuid())
  title          String
  description    String
  imageUrl       String
  destinationUrl String?
  ownerId        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  owner          User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([createdAt, id])
}

model Board {
  id          String   @id @default(cuid())
  name        String
  description String
  coverImage  String?
  isPrivate   Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@index([ownerId, isPrivate, createdAt])
}
