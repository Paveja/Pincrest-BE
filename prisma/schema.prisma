generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(cuid())
  name           String
  username       String     @unique
  email          String     @unique
  passwordHash   String
  profileImage   String?
  bio            String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  sessions       Session[]
  followers      Follow[]   @relation("FollowFollowing")
  following      Follow[]   @relation("FollowFollower")
  pins           Pin[]
  boards         Board[]    @relation("BoardOwner")
  savedPinBoards PinBoard[] @relation("PinBoardSavedByUser")
  likes          Like[]
  comments       Comment[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Follow {
  followerId  String
  followingId String
  follower    User   @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Pin {
  id             String     @id @default(cuid())
  title          String
  description    String
  imageUrl       String
  destinationUrl String?
  ownerId        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  boardPins      PinBoard[]
  likes          Like[]
  comments       Comment[]

  @@index([ownerId])
  @@index([createdAt, id])
}

model Board {
  id          String     @id @default(cuid())
  name        String
  description String
  coverImage  String?
  isPrivate   Boolean    @default(false)
  ownerId     String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  owner       User       @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  pins        PinBoard[]

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([ownerId, isPrivate, createdAt])
}

model PinBoard {
  id            String   @id @default(cuid())
  pinId         String
  boardId       String
  savedByUserId String
  createdAt     DateTime @default(now())
  pin           Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)
  board         Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  savedByUser   User     @relation("PinBoardSavedByUser", fields: [savedByUserId], references: [id], onDelete: Cascade)

  @@unique([pinId, boardId])
  @@index([boardId, createdAt, id])
  @@index([savedByUserId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  pinId     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@unique([userId, pinId])
model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  pinId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pin       Pin      @relation(fields: [pinId], references: [id], onDelete: Cascade)

  @@index([pinId, createdAt, id])
  @@index([userId])
}
